#!/usr/bin/env python3
"""Maintain the canonical skill library across Claude Code, Codex, and Pi.

Subcommands:
  validate    Check the library against the cross-agent contract. Exit 1 on error.

Every rule here exists because at least one agent breaks without it. The `why`
field on each finding names that agent, so a failure explains itself.

Stdlib only: this runs from a git pre-commit hook, which cannot assume PyYAML.
"""

import argparse
import json
import os
import re
import sys

SKILL_FILE = "SKILL.md"
SKILLS_DIR = "skills"
REGISTRY = "registry.yaml"

# Directories inside a skill that hold supporting files rather than more skills.
SUPPORT_DIRS = {"references", "scripts", "assets", "templates"}

DEFAULT_MAX_DESC = 200
DEFAULT_TOTAL_DESC = 9000

ERROR, WARN = "error", "warning"


class Finding:
    def __init__(self, severity, check, path, message, why):
        self.severity = severity
        self.check = check
        self.path = path
        self.message = message
        self.why = why

    def as_dict(self):
        return {
            "severity": self.severity,
            "check": self.check,
            "path": self.path,
            "message": self.message,
            "why": self.why,
        }


def parse_frontmatter(text):
    """Return (dict, error). Handles `key: value`, quoted scalars, and > / | blocks."""
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not m:
        return None, "no YAML frontmatter delimited by ---"
    body = m.group(1)
    data, lines, i = {}, body.split("\n"), 0
    while i < len(lines):
        line = lines[i]
        km = re.match(r"^([A-Za-z][A-Za-z0-9_-]*):\s*(.*)$", line)
        if not km:
            i += 1
            continue
        key, val = km.group(1), km.group(2).strip()
        if val in (">", "|", ">-", "|-", ">+", "|+"):
            i += 1
            block = []
            while i < len(lines) and (lines[i].startswith((" ", "\t")) or not lines[i].strip()):
                block.append(lines[i].strip())
                i += 1
            data[key] = " ".join(x for x in block if x)
            continue
        # An unquoted scalar may wrap onto following indented lines.
        i += 1
        cont = []
        while i < len(lines) and lines[i].startswith((" ", "\t")) and lines[i].strip():
            cont.append(lines[i].strip())
            i += 1
        if cont:
            val = " ".join([val] + cont).strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            quote = val[0]
            val = val[1:-1]
            if quote == '"':
                val = val.replace('\\"', '"').replace("\\\\", "\\")
        data[key] = val
    return data, None


def find_skill_files(root):
    """Every SKILL.md under skills/, including ones reached through a symlinked
    directory. os.walk does not follow symlinks, so those must be collected
    explicitly — otherwise a symlinked skill is invisible here and then silently
    dropped by Codex, which is the exact failure S6 exists to catch."""
    skills_root = os.path.join(root, SKILLS_DIR)
    out = set()
    for dirpath, dirnames, filenames in os.walk(skills_root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        if SKILL_FILE in filenames:
            out.add(os.path.join(dirpath, SKILL_FILE))
        for d in dirnames:
            candidate = os.path.join(dirpath, d)
            if os.path.islink(candidate) and os.path.isfile(os.path.join(candidate, SKILL_FILE)):
                out.add(os.path.join(candidate, SKILL_FILE))
    return sorted(out)


def rel(root, path):
    return os.path.relpath(path, root)


def check_structure(root, skill_files, findings):
    skills_root = os.path.join(root, SKILLS_DIR)
    by_name = {}

    for sf in skill_files:
        sdir = os.path.dirname(sf)
        relpath = rel(root, sf)
        depth = len(os.path.relpath(sdir, skills_root).split(os.sep))

        # S1 — Claude and Codex only scan skills/<name>/SKILL.md, one level deep.
        if depth != 1:
            findings.append(Finding(
                ERROR, "S1-depth", relpath,
                f"skill is {depth} levels below skills/, must be exactly 1",
                "Claude Code and Codex only discover skills/<name>/SKILL.md"))

        # S6 — Codex copies plugins into a cache and silently drops symlinks.
        if os.path.islink(sdir):
            findings.append(Finding(
                ERROR, "S6-symlink", relpath,
                "skill directory is a symlink",
                "Codex drops symlinks when copying a plugin into its cache"))

        # S2 — Pi stops recursing at the first SKILL.md it finds.
        buried = []
        for dp, dn, fn in os.walk(sdir):
            dn[:] = [d for d in dn if not d.startswith(".")]
            if dp == sdir:
                continue
            if SKILL_FILE in fn:
                buried.append(rel(root, os.path.join(dp, SKILL_FILE)))
        if buried:
            findings.append(Finding(
                ERROR, "S2-nested", relpath,
                f"has {len(buried)} SKILL.md beneath it, first: {buried[0]}",
                "Pi stops recursing at the first SKILL.md, hiding everything below"))

        text = open(sf, encoding="utf-8", errors="replace").read()
        fm, err = parse_frontmatter(text)

        # S5 — every agent needs a parseable name and description.
        if err:
            findings.append(Finding(ERROR, "S5-frontmatter", relpath, err,
                                    "all agents read name and description from frontmatter"))
            continue
        name, desc = fm.get("name", "").strip(), fm.get("description", "").strip()
        if not name:
            findings.append(Finding(ERROR, "S5-frontmatter", relpath, "missing name:",
                                    "all agents read name and description from frontmatter"))
        if not desc:
            findings.append(Finding(ERROR, "S5-frontmatter", relpath, "missing description:",
                                    "all agents read name and description from frontmatter"))
        if not name:
            continue

        # S3 — the directory name is the invocation name in every agent.
        dirname = os.path.basename(sdir)
        if name != dirname:
            findings.append(Finding(
                ERROR, "S3-name", relpath,
                f"name '{name}' does not match directory '{dirname}'",
                "the directory name is what each agent exposes as the skill name"))

        by_name.setdefault(name, []).append(relpath)

    # S4 — a duplicate name silently shadows one of the two.
    for name, paths in sorted(by_name.items()):
        if len(paths) > 1:
            findings.append(Finding(
                ERROR, "S4-unique", paths[0],
                f"name '{name}' also declared in {', '.join(paths[1:])}",
                "duplicate names shadow each other with no error"))

    return by_name


def check_budget(root, skill_files, findings, max_desc, total_desc):
    total = 0
    for sf in skill_files:
        fm, err = parse_frontmatter(open(sf, encoding="utf-8", errors="replace").read())
        if err:
            continue
        desc = " ".join((fm.get("description") or "").split())
        total += len(desc)
        # B1 — Codex truncates descriptions to fit a fixed skills budget.
        if len(desc) > max_desc:
            findings.append(Finding(
                ERROR, "B1-desc-length", rel(root, sf),
                f"description is {len(desc)} bytes, limit {max_desc}",
                "Codex silently shortens descriptions past its skills budget"))
    # B2 — the whole library shares that budget.
    if total > total_desc:
        findings.append(Finding(
            ERROR, "B2-desc-total", SKILLS_DIR,
            f"descriptions total {total} bytes, limit {total_desc}",
            "Codex truncates once the combined skills budget is exceeded"))
    return total


LINK_RE = re.compile(r"\]\(([^)#][^)]*)\)")
# Only treat a link target as a file path when it looks like one. Skill bodies
# contain template placeholders such as [<ticket title>](link) in example output.
FILE_LIKE = re.compile(r"(/|\.(md|sh|py|tsv|json|ya?ml|txt|toml))$|/", re.I)
FENCE_RE = re.compile(r"^\s*(```+|~~~+)")


def strip_fences(text):
    """Blank out fenced code blocks. A link inside a fence is sample content the
    skill is teaching the agent to write, not a path it will ever follow."""
    out, fence = [], None
    for line in text.split("\n"):
        m = FENCE_RE.match(line)
        if m:
            marker = m.group(1)[:3]
            if fence is None:
                fence = marker
            elif marker == fence:
                fence = None
            out.append("")
            continue
        out.append("" if fence else line)
    return "\n".join(out)


def link_targets(text):
    """Yield (raw, path, anchor) for each link that names a real file path."""
    for raw in LINK_RE.findall(strip_fences(text)):
        raw = raw.split()[0].strip()
        path, _, anchor = raw.partition("#")
        if not path:
            continue
        if re.match(r"^[a-z]+://", path) or path.startswith("mailto:"):
            continue
        if "<" in path or ">" in path or not FILE_LIKE.search(path):
            continue
        yield raw, path, ("#" + anchor if anchor else "")


def skill_docs(skill_dir):
    """Every Markdown file a skill ships, not just its entrypoint."""
    for dp, dn, fn in os.walk(skill_dir):
        dn[:] = [d for d in dn if not d.startswith(".")]
        for f in sorted(fn):
            if f.endswith(".md"):
                yield os.path.join(dp, f)


def check_integrity(root, skill_files, by_name, findings):
    # I1 — every Markdown file a skill ships, not just SKILL.md: the entrypoint
    # sends the agent into references/, and a broken link there fails mid-run.
    for sf in skill_files:
        sdir = os.path.dirname(sf)
        for doc in skill_docs(sdir):
            text = open(doc, encoding="utf-8", errors="replace").read()
            for _raw, target, _anchor in link_targets(text):
                resolved = os.path.normpath(os.path.join(os.path.dirname(doc), target))
                if os.path.exists(resolved):
                    continue
                inside = os.path.commonpath(
                    [resolved, os.path.abspath(sdir)]) == os.path.abspath(sdir)
                findings.append(Finding(
                    ERROR if inside else WARN, "I1-refs", rel(root, doc),
                    f"link target does not exist: {target}",
                    "the agent reads these paths at run time and fails when they are missing"))

    # I2 — registry.yaml is the inventory; drift means a skill is untracked.
    reg_path = os.path.join(root, REGISTRY)
    if not os.path.exists(reg_path):
        findings.append(Finding(WARN, "I2-registry", REGISTRY, "registry.yaml not found",
                                "the registry is the inventory of record for the library"))
        return
    reg = open(reg_path, encoding="utf-8", errors="replace").read()
    listed = set()
    for m in re.finditer(r"^\s*skills:\s*\[(.*?)\]", reg, re.M | re.S):
        listed.update(s.strip() for s in m.group(1).split(",") if s.strip())
    # Category routers are recorded under `categories:` with a path, not in a
    # package's skills list. They are still inventoried, so count them as listed.
    for m in re.finditer(r"^\s*-\s+id:\s*(\S+)\s*\n\s*path:\s*skills/", reg, re.M):
        listed.add(m.group(1))
    for name in sorted(by_name):
        if name not in listed:
            findings.append(Finding(WARN, "I2-registry", by_name[name][0],
                                    f"'{name}' is not listed in registry.yaml",
                                    "the registry is the inventory of record for the library"))
    on_disk = set(by_name)
    for name in sorted(listed - on_disk):
        findings.append(Finding(WARN, "I2-registry", REGISTRY,
                                f"'{name}' is listed but has no skill directory",
                                "the registry is the inventory of record for the library"))


def skill_name_of(path):
    fm, err = parse_frontmatter(open(path, encoding="utf-8", errors="replace").read())
    if err or not fm:
        return None
    return (fm.get("name") or "").strip() or None


def package_prefixes(root):
    """Map path_prefix -> package id from registry.yaml, for relocating package READMEs."""
    reg = os.path.join(root, REGISTRY)
    if not os.path.exists(reg):
        return {}
    out, current = {}, None
    for line in open(reg, encoding="utf-8", errors="replace"):
        m = re.match(r"^\s*-\s+id:\s*(\S+)", line)
        if m:
            current = m.group(1)
            continue
        m = re.match(r"^\s*path_prefix:\s*(\S+)", line)
        if m and current:
            out[m.group(1).rstrip("/")] = current
    return out


def build_move_map(root, skill_files):
    """Return (dir_moves, file_moves, collisions), all absolute paths.

    Leaf skills flatten to skills/<name>. Category routers already sit at depth 1
    and stay put: once the leaves move out they have nothing beneath them, so the
    routing order in AGENTS.md survives untouched.
    """
    skills_root = os.path.join(root, SKILLS_DIR)
    dir_moves, collisions, claimed = {}, [], {}

    for sf in sorted(skill_files):
        sdir = os.path.dirname(sf)
        parts = os.path.relpath(sdir, skills_root).split(os.sep)
        if len(parts) == 1:
            claimed[parts[0]] = sdir  # router keeps its directory name
            continue
        name = skill_name_of(sf)
        if not name:
            continue
        target = os.path.join(skills_root, name)
        if name in claimed:
            collisions.append((rel(root, sdir), name, rel(root, claimed[name])))
            continue
        claimed[name] = sdir
        dir_moves[sdir] = target

    # Package READMEs are provenance, not skills; park them outside skills/.
    # A README only counts as one when its directory is a grouping directory —
    # it directly contains skill directories that are moving out. That excludes
    # fixture READMEs living inside a skill's own references/.
    file_moves = {}
    prefixes = package_prefixes(root)
    for dirpath, dirnames, filenames in os.walk(skills_root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        if "README.md" not in filenames or SKILL_FILE in filenames:
            continue
        if not any(os.path.join(dirpath, d) in dir_moves for d in dirnames):
            continue
        src = os.path.join(dirpath, "README.md")
        pkg = prefixes.get(rel(root, dirpath))
        if not pkg:
            pkg = "-".join(os.path.relpath(dirpath, skills_root).split(os.sep))
        file_moves[src] = os.path.join(root, "packages", pkg, "README.md")

    return dir_moves, file_moves, collisions


def remap(path, dir_moves, file_moves):
    if path in file_moves:
        return file_moves[path]
    for old, new in dir_moves.items():
        if path == old:
            return new
        if path.startswith(old + os.sep):
            return os.path.join(new, os.path.relpath(path, old))
    return path


def plan_link_rewrites(root, dir_moves, file_moves):
    """Every relative markdown link, resolved from its file's old home and
    recomputed from its new one. Returns {file: [(old_target, new_target)]}."""
    plan = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".") and d != "node_modules"]
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            src = os.path.join(dirpath, fn)
            new_src = remap(src, dir_moves, file_moves)
            text = open(src, encoding="utf-8", errors="replace").read()
            changes = []
            for raw, target, anchor in link_targets(text):
                old_abs = os.path.normpath(os.path.join(dirpath, target))
                new_abs = remap(old_abs, dir_moves, file_moves)
                new_target = os.path.relpath(new_abs, os.path.dirname(new_src))
                # Compare against the *resolved* old target, so "./x" and a
                # trailing slash don't register as changes when nothing moved.
                if new_target != os.path.relpath(old_abs, dirpath):
                    changes.append((raw, new_target + anchor))
            if changes:
                plan[src] = changes
    return plan


def cmd_migrate(args):
    root = os.path.abspath(args.root)
    skill_files = find_skill_files(root)
    dir_moves, file_moves, collisions = build_move_map(root, skill_files)

    if collisions:
        print("BLOCKED — name collisions must be resolved first:\n")
        for src, name, holder in collisions:
            print(f"  {src}: name '{name}' is already used by {holder}")
        return 1

    link_plan = plan_link_rewrites(root, dir_moves, file_moves)
    reg_path = os.path.join(root, REGISTRY)
    reg_drops = []
    if os.path.exists(reg_path):
        for i, line in enumerate(open(reg_path, encoding="utf-8", errors="replace"), 1):
            if re.match(r"^\s*path_prefix:", line):
                reg_drops.append((i, line.rstrip()))

    mode = "APPLYING" if args.apply else "DRY RUN — nothing will move"
    print(f"skills-sync migrate — {mode}\n")

    if not (dir_moves or file_moves or link_plan or reg_drops):
        print(f"Nothing to migrate: all {len(skill_files)} skills are already at "
              f"skills/<name>/.")
        return 0

    print(f"MOVE {len(dir_moves)} skill directories to skills/<name>/")
    for old in sorted(dir_moves):
        print(f"  {rel(root, old)}  ->  {rel(root, dir_moves[old])}")
    print()

    if file_moves:
        print(f"MOVE {len(file_moves)} package README(s) out of skills/")
        for old in sorted(file_moves):
            print(f"  {rel(root, old)}  ->  {rel(root, file_moves[old])}")
        print()

    total_links = sum(len(v) for v in link_plan.values())
    print(f"REWRITE {total_links} link(s) across {len(link_plan)} file(s)")
    for f in sorted(link_plan):
        print(f"  {rel(root, f)}")
        for old, new in link_plan[f][:args.limit]:
            print(f"      {old}  ->  {new}")
        if len(link_plan[f]) > args.limit:
            print(f"      … and {len(link_plan[f]) - args.limit} more")
    print()

    if reg_drops:
        print(f"EDIT {REGISTRY} — remove {len(reg_drops)} obsolete path_prefix line(s)")
        for ln, txt in reg_drops:
            print(f"  line {ln}: {txt.strip()}")
        print()

    routers = [rel(root, os.path.dirname(sf)) for sf in skill_files
               if len(os.path.relpath(os.path.dirname(sf),
                                      os.path.join(root, SKILLS_DIR)).split(os.sep)) == 1]
    print(f"KEEP {len(routers)} category router(s) in place: {', '.join(sorted(os.path.basename(r) for r in routers))}")
    print("  they sit at depth 1 already; once the leaves move out nothing is nested beneath them\n")

    if not args.apply:
        print("Re-run with --apply to perform the migration.")
        return 0

    import subprocess

    def git(*a):
        return subprocess.run(["git", "-C", root] + list(a),
                              capture_output=True, text=True)

    for old in sorted(dir_moves, key=len, reverse=True):
        new = dir_moves[old]
        os.makedirs(os.path.dirname(new), exist_ok=True)
        r = git("mv", rel(root, old), rel(root, new))
        if r.returncode != 0:
            print(f"git mv failed for {rel(root, old)}: {r.stderr.strip()}")
            return 1
    for old, new in file_moves.items():
        os.makedirs(os.path.dirname(new), exist_ok=True)
        r = git("mv", rel(root, old), rel(root, new))
        if r.returncode != 0:
            print(f"git mv failed for {rel(root, old)}: {r.stderr.strip()}")
            return 1

    for src, changes in link_plan.items():
        new_src = remap(src, dir_moves, file_moves)
        text = open(new_src, encoding="utf-8", errors="replace").read()
        for old, new in changes:
            text = text.replace(f"]({old})", f"]({new})")
        open(new_src, "w", encoding="utf-8").write(text)

    if reg_drops:
        lines = open(reg_path, encoding="utf-8", errors="replace").read().split("\n")
        lines = [l for l in lines if not re.match(r"^\s*path_prefix:", l)]
        open(reg_path, "w", encoding="utf-8").write("\n".join(lines))

    print("Migration applied. Re-running validate:\n")
    args.json = args.strict = False
    args.max_desc, args.total_desc = DEFAULT_MAX_DESC, DEFAULT_TOTAL_DESC
    rc = cmd_validate(args)
    if rc != 0:
        return rc
    # Moving the directories invalidates every installed link. Reconcile now, or
    # the local install silently points at paths that no longer exist.
    print()
    args.dry_run = False
    return cmd_refresh(args)


MANIFESTS = (".claude-plugin/plugin.json", ".codex-plugin/plugin.json")
VERSION_FILE = "VERSION"


TAG_PREFIX = "V"  # matches the tags already in this repository (V0.1 … V0.4.0)


def derived_version(root):
    """MAJOR.MINOR from VERSION; the patch advances only when skills change.

    Claude Code and Codex ship an update only when the manifest version changes,
    so the patch is computed rather than remembered: it cannot fail to move when
    the library does. It advances at most one per release, which keeps the
    sequence readable next to the existing V0.1 … V0.4.0 tags.
    """
    vf = os.path.join(root, VERSION_FILE)
    base = open(vf, encoding="utf-8").read().strip() if os.path.exists(vf) else "0.1"

    pat = re.compile(rf"^{re.escape(TAG_PREFIX)}?{re.escape(base)}\.(\d+)$")
    tags = []
    for line in git(root, "tag", "--list").stdout.split("\n"):
        m = pat.match(line.strip())
        if m:
            tags.append((int(m.group(1)), line.strip()))
    if not tags:
        return f"{base}.0", base, "0"

    patch, tag = max(tags)
    changed = git(root, "rev-list", "--count", f"{tag}..HEAD", "--", SKILLS_DIR)
    moved = changed.returncode == 0 and changed.stdout.strip() not in ("", "0")
    patch += 1 if moved else 0
    return f"{base}.{patch}", base, str(patch)


def manifest_versions(root):
    out = {}
    for m in MANIFESTS:
        p = os.path.join(root, m)
        if not os.path.exists(p):
            out[m] = None
            continue
        try:
            out[m] = json.load(open(p, encoding="utf-8")).get("version")
        except Exception as e:
            out[m] = f"<unreadable: {e}>"
    return out


def cmd_version(args):
    root = os.path.abspath(args.root)
    version, base, patch = derived_version(root)
    current = manifest_versions(root)
    print(f"derived version: {version}   ({VERSION_FILE}={base}, "
          f"{patch} commit(s) touching {SKILLS_DIR}/)\n")

    stale = [m for m, v in current.items() if v != version]
    for m, v in current.items():
        state = "ok" if v == version else ("missing" if v is None else f"stale ({v})")
        print(f"  {m:34} {state}")

    if not stale:
        print("\nManifests are up to date.")
        return 0
    if not args.write:
        print(f"\n{len(stale)} manifest(s) out of date — re-run with --write to update.")
        return 1

    for m in stale:
        p = os.path.join(root, m)
        if not os.path.exists(p):
            print(f"\ncannot write {m}: file does not exist")
            return 1
        d = json.load(open(p, encoding="utf-8"))
        d["version"] = version
        with open(p, "w", encoding="utf-8") as fh:
            json.dump(d, fh, indent=2)
            fh.write("\n")
    print(f"\nWrote {version} to {len(stale)} manifest(s).")
    return 0


def repo_skill_names(root):
    skills_root = os.path.join(root, SKILLS_DIR)
    if not os.path.isdir(skills_root):
        return {}
    out = {}
    for name in sorted(os.listdir(skills_root)):
        d = os.path.join(skills_root, name)
        if os.path.isfile(os.path.join(d, SKILL_FILE)):
            out[name] = d
    return out


def link_target(path):
    """Absolute target of a symlink, even when it dangles."""
    t = os.readlink(path)
    return os.path.normpath(t if os.path.isabs(t)
                            else os.path.join(os.path.dirname(path), t))


def under(path, parent):
    path, parent = os.path.abspath(path), os.path.abspath(parent)
    return path == parent or path.startswith(parent + os.sep)


def reconcile_links(root, install_dir, skills, dry_run):
    """Make install_dir mirror the repo's skills, one symlink per skill.

    Only entries that are symlinks pointing into this repository are ours to
    manage. A real directory, or a link into some other library, belongs to
    someone else and is never touched — at most it is reported as a conflict.
    """
    actions, conflicts = [], []
    os.makedirs(install_dir, exist_ok=True)

    managed = {}
    for name in sorted(os.listdir(install_dir)):
        p = os.path.join(install_dir, name)
        if os.path.islink(p) and under(link_target(p), os.path.join(root, SKILLS_DIR)):
            managed[name] = p
        elif name in skills:
            conflicts.append(name)

    for name in sorted(set(managed) - set(skills)):
        actions.append(("unlink", name, "skill no longer in the repo"))
        if not dry_run:
            os.unlink(managed[name])
    for name, src in sorted(skills.items()):
        p = os.path.join(install_dir, name)
        if name in managed:
            reason = ("target moved" if link_target(p) != os.path.abspath(src)
                      else "dangling link" if not os.path.exists(p) else None)
            if reason:
                actions.append(("relink", name, reason))
                if not dry_run:
                    os.unlink(p)
                    os.symlink(os.path.abspath(src), p)
        elif name not in conflicts:
            actions.append(("link", name, "new"))
            if not dry_run:
                os.symlink(os.path.abspath(src), p)
    return actions, conflicts


def refresh_claude(root, skills, dry_run):
    # Honour CLAUDE_CONFIG_DIR the same way Claude Code does, so a relocated
    # config directory is still reconciled (and so this is testable).
    config = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude"))
    if not os.path.isdir(config):
        return None, [], []
    home = os.path.join(config, "skills")
    actions, conflicts = reconcile_links(root, home, skills, dry_run)
    return home, actions, conflicts


def refresh_pi(root, skills, dry_run):
    """Pi loads skills from <agent dir>/skills, where the agent dir is
    ~/.pi/agent unless PI_AGENT_DIR overrides it. It follows symlinks, so the
    same reconcile as Claude applies.

    Note .agents/skills is *not* a Pi load path: it appears only in Pi's trust
    logic, as a project resource that requires trust before it is honoured.
    """
    agent = os.path.expanduser(os.environ.get("PI_AGENT_DIR", "~/.pi/agent"))
    if not os.path.isdir(agent):
        return None, [], []
    home = os.path.join(agent, "skills")
    actions, conflicts = reconcile_links(root, home, skills, dry_run)
    return home, actions, conflicts


def refresh_codex(root, skills, dry_run):
    """Codex installs from a marketplace, so it needs the packaging manifests
    before anything can be refreshed."""
    import shutil
    if not shutil.which("codex"):
        return None, [], "codex is not on PATH"
    missing = [p for p in (".claude-plugin/marketplace.json", ".codex-plugin/plugin.json")
               if not os.path.exists(os.path.join(root, p))]
    if missing:
        return None, [], f"not packaged yet, missing {', '.join(missing)}"
    import subprocess
    version, _, _ = derived_version(root)
    marketplace = json.load(open(os.path.join(root, ".claude-plugin/marketplace.json"),
                                 encoding="utf-8"))
    plugin = json.load(open(os.path.join(root, ".codex-plugin/plugin.json"),
                            encoding="utf-8"))["name"]
    selector = f"{plugin}@{marketplace['name']}"
    cache = os.path.expanduser(
        f"~/.codex/plugins/cache/{marketplace['name']}/{plugin}/{version}")

    # Existence is not enough: a cache directory can carry stale contents from a
    # version that was later rewritten, and Codex reads that copy, not the repo.
    cached = (set(os.listdir(os.path.join(cache, "skills")))
              if os.path.isdir(os.path.join(cache, "skills")) else None)
    if cached == set(skills):
        return "codex", [], None
    why = (f"cache missing for {version}" if cached is None
           else f"cache has {len(cached)} skills, repo has {len(skills)}")
    if dry_run:
        return "codex", [("install", selector, why)], None
    # `marketplace upgrade` only refreshes Git marketplaces, so it is a no-op for a
    # local checkout. `plugin add` re-reads the marketplace and installs the version
    # in the manifest, replacing the previous cache entry.
    subprocess.run(["codex", "plugin", "marketplace", "upgrade"],
                   capture_output=True, text=True)
    r = subprocess.run(["codex", "plugin", "add", selector], capture_output=True, text=True)
    note = "installed" if r.returncode == 0 else (r.stderr.strip() or "failed")
    return "codex", [("install", selector, f"{version} — {note}")], None


def cmd_refresh(args):
    # --quiet buffers everything and prints only when something actually changed,
    # so a post-commit hook stays silent on a no-op commit.
    if getattr(args, "quiet", False):
        import io, contextlib
        buf = io.StringIO()
        args.quiet = False
        with contextlib.redirect_stdout(buf):
            rc = cmd_refresh(args)
        out = buf.getvalue()
        if "\n0 change(s)" not in out:
            sys.stdout.write(out)
        return rc

    root = os.path.abspath(args.root)
    skills = repo_skill_names(root)
    dry = args.dry_run
    print(f"skills-sync refresh — {len(skills)} skills in the repo"
          f"{' (DRY RUN)' if dry else ''}\n")

    total = 0
    home, actions, conflicts = refresh_claude(root, skills, dry)
    if home is None:
        print("claude   skipped — ~/.claude not found")
    else:
        print(f"claude   {home}")
        for kind, name, why in actions:
            print(f"         {kind:7} {name}  ({why})")
        if not actions:
            print("         already in sync")
        for name in conflicts:
            print(f"         CONFLICT {name} exists and is not ours — left untouched")
        total += len(actions)

    pi_home, pi_actions, pi_conflicts = refresh_pi(root, skills, dry)
    if pi_home is None:
        print("\npi       skipped — ~/.pi/agent not found")
    else:
        print(f"\npi       {pi_home}")
        for kind, name, why in pi_actions[:12]:
            print(f"         {kind:7} {name}  ({why})")
        if len(pi_actions) > 12:
            print(f"         … and {len(pi_actions) - 12} more")
        if not pi_actions:
            print("         already in sync")
        for name in pi_conflicts:
            print(f"         CONFLICT {name} exists and is not ours — left untouched")
        total += len(pi_actions)

    _, cx_actions, cx_note = refresh_codex(root, skills, dry)
    print("\ncodex    ", end="")
    if cx_note:
        print(f"skipped — {cx_note}")
    else:
        print("marketplace")
        for kind, name, why in cx_actions:
            print(f"         {kind:7} {name}  ({why})")
        total += len(cx_actions)

    print(f"\n{total} change(s)" + (" — re-run without --dry-run to apply" if dry and total
                                    else ""))
    if total and not dry:
        print("Claude Code and Codex load skills at startup: restart or /reload-plugins.")
    return 0


def git(root, *a):
    import subprocess
    return subprocess.run(["git", "-C", root] + list(a), capture_output=True, text=True)


def changed_skills(root, since):
    """Skill names touched since a ref, for pointing at the eval cases that cover them."""
    if not since:
        return None
    r = git(root, "diff", "--name-only", f"{since}..HEAD", "--", SKILLS_DIR)
    if r.returncode != 0:
        return None
    names = set()
    for line in r.stdout.split("\n"):
        parts = line.strip().split("/")
        if len(parts) >= 2 and parts[0] == SKILLS_DIR:
            names.add(parts[1])
    return names


def relevant_evals(root, names):
    out = {}
    evdir = os.path.join(root, "evals")
    if not os.path.isdir(evdir) or not names:
        return out
    for f in sorted(os.listdir(evdir)):
        if not f.endswith(".md"):
            continue
        text = open(os.path.join(evdir, f), encoding="utf-8", errors="replace").read()
        hit = sorted(n for n in names if n in text)
        if hit:
            out[f] = hit
    return out


def parse_registry(path):
    """Minimal reader for registry.yaml's shape: top-level keys holding a block
    sequence of flat mappings, with inline [a, b] lists. Enough for sources and
    packages, and it keeps the stdlib-only rule that lets hooks run anywhere."""
    out, section, item = {}, None, None
    for raw in open(path, encoding="utf-8", errors="replace").read().split("\n"):
        line = raw.split(" #")[0].rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        top = re.match(r"^([a-z_]+):\s*$", line)
        if top:
            section = top.group(1)
            out[section] = []
            item = None
            continue
        if section is None:
            continue
        m = re.match(r"^\s*-\s+([a-z_]+):\s*(.*)$", line)
        if m:
            item = {}
            out[section].append(item)
            key, val = m.group(1), m.group(2)
        else:
            m = re.match(r"^\s+([a-z_]+):\s*(.*)$", line)
            if not m or item is None:
                continue
            key, val = m.group(1), m.group(2)
        val = val.strip()
        if val.startswith("[") and val.endswith("]"):
            item[key] = [v.strip() for v in val[1:-1].split(",") if v.strip()]
        else:
            item[key] = val.strip('"\'')
    return out


def split_repo_url(url):
    """GitHub tree URLs point at a subdirectory of a monorepo. Return
    (clone url, subdirectory)."""
    m = re.match(r"^(https://[^/]+/[^/]+/[^/]+?)(?:\.git)?/tree/[^/]+/(.+)$", url)
    if m:
        return m.group(1), m.group(2).rstrip("/")
    return re.sub(r"\.git$", "", url), ""


def upstream_clone(source_id, url, offline):
    """A blobless mirror in the cache: enough history to diff, little to download."""
    import subprocess
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, "skills-sync", source_id)
    if not os.path.isdir(os.path.join(path, ".git")):
        if offline:
            return None, "no cached clone and --offline was given"
        os.makedirs(os.path.dirname(path), exist_ok=True)
        r = subprocess.run(["git", "clone", "--filter=blob:none", "--no-checkout",
                            "-q", url, path], capture_output=True, text=True)
        if r.returncode != 0:
            return None, f"clone failed: {r.stderr.strip()[:160]}"
        return path, None
    if not offline:
        r = subprocess.run(["git", "-C", path, "fetch", "-q", "--filter=blob:none",
                            "origin"], capture_output=True, text=True)
        if r.returncode != 0:
            return path, f"fetch failed, using cached copy: {r.stderr.strip()[:120]}"
    return path, None


def upstream_head(repo):
    for ref in ("origin/HEAD", "origin/main", "origin/master"):
        r = git(repo, "rev-parse", "-q", "--verify", ref)
        if r.returncode == 0:
            return r.stdout.strip()
    return None


def local_differences(root, name, repo, pinned, upath):
    """Files under a vendored skill that differ from the upstream commit we
    pinned. These are the local adaptations that an upstream change may collide
    with, which is the thing worth knowing before adopting anything."""
    listing = git(repo, "ls-tree", "-r", "--name-only", pinned, "--", upath)
    if listing.returncode != 0:
        return None
    edited, omitted = [], []
    for f in [x for x in listing.stdout.split("\n") if x.strip()]:
        relp = os.path.relpath(f, upath)
        localp = os.path.join(root, SKILLS_DIR, name, relp)
        blob = git(repo, "show", f"{pinned}:{f}")
        if blob.returncode != 0:
            continue
        if not os.path.exists(localp):
            # A file we deliberately did not vendor, such as an agent-specific
            # manifest. Different in kind from an edit, and much less interesting.
            omitted.append(relp)
        elif open(localp, encoding="utf-8", errors="replace").read() != blob.stdout:
            edited.append(relp)
    return edited, omitted


def cmd_upstream(args):
    """Report what changed in the skills we vendored, since the commit we pinned.

    It never edits a skill. AGENTS.md requires that upstream changes be compared
    against local intent and evaluations before adoption, so this produces the
    comparison and stops.
    """
    root = os.path.abspath(args.root)
    reg = parse_registry(os.path.join(root, REGISTRY))
    sources = {s["id"]: s for s in reg.get("sources", []) if "id" in s}
    packages = [p for p in reg.get("packages", []) if p.get("source") in sources]

    wanted = args.source
    report, any_changes = [], False

    for src_id in sorted({p["source"] for p in packages}):
        if wanted and src_id != wanted:
            continue
        src = sources[src_id]
        url, subdir = split_repo_url(src.get("repository", ""))
        pinned = src.get("reference", "")
        print(f"\n{src_id}")
        print(f"  repository {url}" + (f"  (subdirectory {subdir})" if subdir else ""))

        repo, err = upstream_clone(src_id, url, args.offline)
        if repo is None:
            print(f"  SKIP  {err}")
            continue
        if err:
            print(f"  note  {err}")
        head = upstream_head(repo)
        if not head:
            print("  SKIP  could not resolve the upstream default branch")
            continue
        if git(repo, "cat-file", "-t", pinned).stdout.strip() != "commit":
            print(f"  SKIP  pinned reference {pinned[:12]} is not in this repository")
            continue

        print(f"  pinned     {pinned[:12]}")
        print(f"  upstream   {head[:12]}"
              + ("  (same commit)" if head.startswith(pinned[:12]) else ""))

        for pkg in [p for p in packages if p["source"] == src_id]:
            # upstream_prefix may be a single path or several, when a package
            # draws skills from more than one upstream directory.
            prefixes = pkg.get("upstream_prefix", "")
            if isinstance(prefixes, str):
                prefixes = [prefixes]
            prefix = ", ".join(prefixes) if prefixes else ""
            names = pkg.get("skills", [])
            changed, adapted, omitted, missing = {}, {}, {}, []
            for name in names:
                upath = None
                for pfx in prefixes or [""]:
                    cand = "/".join(x for x in (subdir, pfx, name) if x)
                    if git(repo, "cat-file", "-t", f"{pinned}:{cand}").returncode == 0:
                        upath = cand
                        break
                if upath is None:
                    missing.append(name)
                    continue
                d = git(repo, "diff", "--name-only", f"{pinned}..{head}", "--", upath)
                files = [f for f in d.stdout.split("\n") if f.strip()]
                if files:
                    changed[name] = [os.path.relpath(f, upath) for f in files]
                local = local_differences(root, name, repo, pinned, upath)
                if local and local[0]:
                    adapted[name] = local[0]
                if local and local[1]:
                    omitted[name] = local[1]

            print(f"\n  package {pkg['id']} — {len(names)} skill(s), "
                  f"prefix {prefix or '(root)'}")
            if changed:
                any_changes = True
                print(f"    changed upstream ({len(changed)}):")
                for name in sorted(changed):
                    overlap = sorted(set(changed[name]) & set(adapted.get(name, [])))
                    flag = ("  CONFLICT: you also changed " + ", ".join(overlap)
                            if overlap else
                            "  (locally adapted elsewhere)" if name in adapted else "")
                    print(f"      {name:32} {', '.join(changed[name][:3])}{flag}")
            else:
                print("    changed upstream: none")
            if adapted and args.show_adaptations:
                print(f"    locally edited ({len(adapted)}):")
                for name in sorted(adapted):
                    print(f"      {name:32} {', '.join(adapted[name][:3])}")
            elif adapted:
                print(f"    locally edited: {len(adapted)} skill(s) "
                      f"(--show-adaptations to list)")
            if omitted:
                files = sorted({f for v in omitted.values() for f in v})
                print(f"    not vendored by choice: {', '.join(files[:3])}"
                      f" (in {len(omitted)} skill(s))")
            if missing:
                # A skill adapted from an upstream *method* rather than copied
                # from an upstream directory has nothing to diff against. That is
                # a legitimate provenance, not a fault, so say which it is.
                kind = ("all of them" if len(missing) == len(names)
                        else f"{len(missing)} of {len(names)}")
                print(f"    no upstream directory ({kind}): {', '.join(missing[:4])}")
                print(f"      derived from this source rather than vendored from it; "
                      f"changes here need a human read of the upstream method")

            # Upstream skills we never vendored, so a new one is visible.
            avail = set()
            for pfx in prefixes or [""]:
                base = "/".join(x for x in (subdir, pfx) if x)
                tree = git(repo, "ls-tree", "-d", "--name-only", f"{head}:{base}")
                if tree.returncode != 0:
                    continue
                for x in [y.strip("/") for y in tree.stdout.split("\n") if y.strip()]:
                    # A directory is a skill only when it carries a SKILL.md.
                    if git(repo, "cat-file", "-t",
                           f"{head}:{base}/{x}/SKILL.md").returncode == 0:
                        avail.add(x)
            if avail:
                new = sorted(avail - set(names))
                if new:
                    print(f"    upstream has {len(new)} not vendored: "
                          f"{', '.join(new[:8])}{' …' if len(new) > 8 else ''}")

        report.append((src_id, pinned, head))

    if args.pin:
        entry = next((r for r in report if r[0] == args.pin), None)
        if not entry:
            print(f"\nCannot pin {args.pin}: it was not compared in this run.")
            return 1
        _, old, new = entry
        if old == new:
            print(f"\n{args.pin} is already pinned to {new[:12]}.")
            return 0
        p = os.path.join(root, REGISTRY)
        text = open(p, encoding="utf-8").read()
        if old not in text:
            print(f"\nCannot pin {args.pin}: reference {old[:12]} not found in registry.")
            return 1
        open(p, "w", encoding="utf-8").write(text.replace(old, new))
        print(f"\nPinned {args.pin} to {new[:12]} in {REGISTRY}. "
              f"Record the adoption in the changelog.")
        return 0

    print("\nNothing was modified. Adopt a change by editing the skill, then "
          "`upstream --pin <source>`." if any_changes else
          "\nEverything vendored is current with its pinned commit.")
    return 0


def cmd_doctor(args):
    """Report drift without touching anything.

    Every check here corresponds to a way this setup has actually broken: a move
    that dangled the installed links, a version that never shipped, hooks that
    were never wired on a fresh clone, a foreign directory shadowing a skill.
    doctor never repairs — that is refresh's job — so it stays safe to run
    anywhere, including from a script.
    """
    root = os.path.abspath(args.root)
    rows = []

    def check(section, name, level, detail=""):
        rows.append((section, name, level, detail))

    tools = detect_tools()
    for name, path in tools.items():
        check("tools", name, "ok" if path else "warn",
              path or "not on PATH")

    # Repository
    import io, contextlib
    vargs = argparse.Namespace(root=root, json=False, strict=False,
                               max_desc=DEFAULT_MAX_DESC,
                               total_desc=DEFAULT_TOTAL_DESC, limit=3)
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        vrc = cmd_validate(vargs)
    summary = buf.getvalue().strip().splitlines()
    check("repo", "validate", "ok" if vrc == 0 else "fail",
          summary[-1] if summary else "")

    dirty = git(root, "status", "--porcelain").stdout.strip()
    check("repo", "working tree", "ok" if not dirty else "warn",
          "clean" if not dirty else f"{len(dirty.splitlines())} uncommitted change(s)")

    branch = git(root, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    counts = git(root, "rev-list", "--left-right", "--count",
                 f"{branch}...origin/{branch}").stdout.split()
    if len(counts) == 2:
        ahead, behind = counts
        level = "ok" if ahead == "0" and behind == "0" else "warn"
        state = "in sync with origin" if level == "ok" else f"{ahead} ahead, {behind} behind"
        check("repo", "branch", level, f"{branch}, {state}")
    else:
        check("repo", "branch", "warn", f"{branch}, no upstream")

    # Release
    version, _, _ = derived_version(root)
    current = manifest_versions(root)
    stale = [m for m, v in current.items() if v != version]
    check("release", "manifests", "ok" if not stale else "fail",
          f"at {version}" if not stale else
          f"derived {version}, manifests {sorted(set(map(str, current.values())))}")

    tag = f"{TAG_PREFIX}{version}"
    tagged = git(root, "rev-parse", "-q", "--verify", f"refs/tags/{tag}").returncode == 0
    if tagged:
        unreleased = git(root, "rev-list", "--count", f"{tag}..HEAD",
                         "--", SKILLS_DIR).stdout.strip()
        check("release", "published", "ok" if unreleased == "0" else "warn",
              f"{tag} is current" if unreleased == "0" else
              f"{unreleased} skill commit(s) since {tag} — run release")
    else:
        check("release", "published", "warn", f"{tag} not tagged yet — run release")

    # Hooks
    hooks_dir = os.path.join(root, HOOKS_DIR)
    path_set = git(root, "config", "--get", "core.hooksPath").stdout.strip()
    present = sorted(os.listdir(hooks_dir)) if os.path.isdir(hooks_dir) else []
    nonexec = [f for f in present if not os.access(os.path.join(hooks_dir, f), os.X_OK)]
    if path_set != HOOKS_DIR:
        check("hooks", "core.hooksPath", "fail",
              f"{path_set or 'unset'} — run `skills-sync hooks --install`")
    elif nonexec:
        check("hooks", "core.hooksPath", "fail",
              f"not executable: {', '.join(nonexec)}")
    else:
        check("hooks", "core.hooksPath", "ok", f"{HOOKS_DIR} ({len(present)} hooks)")

    # Installs — ask refresh what it would change, but change nothing.
    skills = repo_skill_names(root)
    for label, fn in (("claude", refresh_claude), ("pi", refresh_pi)):
        home, actions, conflicts = fn(root, skills, True)
        if home is None:
            check("installs", label, "warn", "not installed on this machine")
            continue
        if conflicts:
            # Report drift too: a conflict must not mask an out-of-date install.
            extra = f", and {len(actions)} other change(s) pending" if actions else ""
            check("installs", label, "fail",
                  f"{len(conflicts)} name(s) shadowed by foreign entries: "
                  f"{', '.join(conflicts[:3])}{extra}")
        elif actions:
            kinds = {}
            for kind, _, _ in actions:
                kinds[kind] = kinds.get(kind, 0) + 1
            check("installs", label, "warn",
                  f"{len(actions)} out of sync ({', '.join(f'{v} {k}' for k, v in sorted(kinds.items()))}) — run refresh")
        else:
            check("installs", label, "ok", f"{len(skills)} skills")

    mk = os.path.join(root, ".claude-plugin/marketplace.json")
    if not tools["codex"]:
        check("installs", "codex", "warn", "codex is not on PATH")
    elif not os.path.exists(mk):
        check("installs", "codex", "fail", "marketplace manifest missing")
    else:
        m = json.load(open(mk, encoding="utf-8"))["name"]
        pl = json.load(open(os.path.join(root, ".codex-plugin/plugin.json"),
                            encoding="utf-8"))["name"]
        base = os.path.expanduser(f"~/.codex/plugins/cache/{m}/{pl}")
        have = sorted(os.listdir(base)) if os.path.isdir(base) else []
        if version in have:
            cached = set(os.listdir(os.path.join(base, version, "skills")))
            check("installs", "codex", "ok" if cached == set(skills) else "fail",
                  f"{version}" if cached == set(skills) else
                  f"{len(cached)} cached vs {len(skills)} in repo")
        else:
            check("installs", "codex", "warn",
                  f"cache has {have or 'nothing'}, repo is at {version} — run refresh")

    if args.json:
        print(json.dumps([{"section": s, "check": n, "level": l, "detail": d}
                          for s, n, l, d in rows], indent=2))
    else:
        print("skills-sync doctor\n")
        last = None
        for section, name, level, detail in rows:
            if section != last:
                print(f"{section}")
                last = section
            print(f"  {level.upper():4}  {name:14} {detail}")
        fails = [r for r in rows if r[2] == "fail"]
        warns = [r for r in rows if r[2] == "warn"]
        print(f"\n{len(fails)} failing, {len(warns)} warning(s)")

    fails = sum(1 for r in rows if r[2] == "fail")
    warns = sum(1 for r in rows if r[2] == "warn")
    return 1 if fails or (args.strict and warns) else 0


def origin_slug(root):
    """owner/repo from the origin remote, for marketplace sources."""
    url = git(root, "config", "--get", "remote.origin.url").stdout.strip()
    if not url:
        return None, None
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    return (m.group(1) if m else None), url


def detect_tools():
    import shutil
    return {name: shutil.which(name) for name in ("git", "claude", "codex", "pi")}


def cmd_bootstrap(args):
    """Set a machine up from a fresh clone.

    Two roles, because they want opposite things. An authoring machine should
    see its own edits immediately, so it installs from the working tree and runs
    the hooks. A consuming machine should track published releases, so it
    installs from the remote and never has its install moved by a stray edit.
    """
    root = os.path.abspath(args.root)
    tools = detect_tools()
    slug, url = origin_slug(root)
    skills = repo_skill_names(root)

    role = args.role
    if not role:
        if sys.stdin.isatty():
            print("This machine will be:\n"
                  "  1. author   — you edit skills here; installs from this working tree,\n"
                  "                git hooks validate and reconcile on every commit\n"
                  "  2. consumer — you only use skills here; installs from the remote and\n"
                  "                tracks published releases\n")
            choice = input("Choose 1 or 2: ").strip()
            role = {"1": "author", "2": "consumer"}.get(choice)
        if not role:
            print("Pass --role author or --role consumer.")
            return 1

    print(f"\nskills-sync bootstrap — role: {role}"
          f"{'' if args.apply else '  (DRY RUN)'}\n")

    print("Detected")
    for name, path in tools.items():
        print(f"  {'ok  ' if path else 'MISS'} {name:7} {path or 'not on PATH'}")
    print(f"  ok   repo    {root}")
    print(f"  {'ok  ' if slug else 'MISS'} origin  {url or 'no origin remote'}")
    print(f"  ok   skills  {len(skills)}")

    if not tools["git"]:
        print("\ngit is required.")
        return 1
    if role == "consumer" and not slug:
        print("\nA consumer install needs an origin remote to track. "
              "Add one, or use --role author.")
        return 1

    steps = []
    if role == "author":
        steps.append(("git hooks", f"set core.hooksPath to {HOOKS_DIR}"))
        if tools["claude"]:
            steps.append(("claude", f"link {len(skills)} skills into the user skills dir"))
        if tools["pi"]:
            steps.append(("pi", f"link {len(skills)} skills into the agent skills dir"))
        if tools["codex"]:
            steps.append(("codex", "add this checkout as a marketplace, install the plugin"))
    else:
        if tools["claude"]:
            steps.append(("claude", f"add marketplace {slug}, install the plugin"))
        if tools["codex"]:
            steps.append(("codex", f"add marketplace {slug}, install the plugin"))
        if tools["pi"]:
            steps.append(("pi", "no marketplace; link from this clone and git pull to update"))

    print("\nWould do:" if not args.apply else "\nDoing:")
    for who, what in steps:
        print(f"  {who:8} {what}")

    if role == "author" and slug:
        print(f"\n  Note: this checkout pushes to {slug}. To work from your own fork,"
              f"\n  repoint it first: git remote set-url origin <your fork>")

    if not args.apply:
        print("\nRe-run with --apply.")
        return 0

    import subprocess
    print()
    if role == "author":
        hargs = argparse.Namespace(root=root, install=True, uninstall=False)
        cmd_hooks(hargs)
        print()
        rargs = argparse.Namespace(root=root, dry_run=False, quiet=False)
        cmd_refresh(rargs)
    else:
        for tool in ("claude", "codex"):
            if not tools[tool]:
                continue
            a = subprocess.run([tool, "plugin", "marketplace", "add", slug],
                               capture_output=True, text=True)
            print(f"  {tool}: marketplace {'added' if a.returncode == 0 else 'failed'}"
                  f"{'' if a.returncode == 0 else ' — ' + (a.stderr.strip()[:120])}")
            mk = os.path.join(root, ".claude-plugin/marketplace.json")
            name = json.load(open(mk, encoding="utf-8"))["name"]
            plugin = json.load(open(os.path.join(root, ".codex-plugin/plugin.json"),
                                    encoding="utf-8"))["name"]
            verb = "install" if tool == "claude" else "add"
            b = subprocess.run([tool, "plugin", verb, f"{plugin}@{name}"],
                               capture_output=True, text=True)
            print(f"  {tool}: plugin {'installed' if b.returncode == 0 else 'failed'}"
                  f"{'' if b.returncode == 0 else ' — ' + (b.stderr.strip()[:120])}")

    print("\nDone. Claude Code, Codex, and Pi read skills at startup — restart them.")
    return 0


HOOKS_DIR = ".githooks"


def cmd_hooks(args):
    """Point git at the committed hooks.

    Git never clones .git/hooks, so hooks in a repository are inert until each
    clone sets core.hooksPath. That one command is the only manual step in the
    whole setup; everything after it is automatic.
    """
    root = os.path.abspath(args.root)
    hooks = os.path.join(root, HOOKS_DIR)
    current = git(root, "config", "--get", "core.hooksPath").stdout.strip()
    present = sorted(os.listdir(hooks)) if os.path.isdir(hooks) else []

    if args.uninstall:
        if not current:
            print("core.hooksPath is not set; nothing to remove.")
            return 0
        git(root, "config", "--unset", "core.hooksPath")
        print(f"Unset core.hooksPath (was {current}).")
        return 0

    print(f"hooks in {HOOKS_DIR}/: {', '.join(present) or 'none'}")
    for f in present:
        if not os.access(os.path.join(hooks, f), os.X_OK):
            print(f"  WARNING {f} is not executable; git will ignore it")
    print(f"core.hooksPath: {current or '(unset)'}")

    if current == HOOKS_DIR:
        print("\nInstalled.")
        return 0
    if not args.install:
        print("\nNot installed. Run `bin/skills-sync hooks --install`.")
        return 1
    r = git(root, "config", "core.hooksPath", HOOKS_DIR)
    if r.returncode != 0:
        print(f"failed: {r.stderr.strip()}")
        return 1
    print(f"\nSet core.hooksPath to {HOOKS_DIR}.")
    return 0


def cmd_release(args):
    """Gate a release: prove the library is sound, publish it, then prove the local
    install actually moved. Each gate blocks; cheap ones run first."""
    import shutil
    root = os.path.abspath(args.root)
    apply = args.apply
    print(f"skills-sync release — {'APPLYING' if apply else 'PREFLIGHT (dry run)'}\n")

    failures = []

    def gate(name, ok, detail=""):
        print(f"  {'PASS' if ok else 'FAIL'}  {name}" + (f"  — {detail}" if detail else ""))
        if not ok:
            failures.append(name)
        return ok

    print("Preflight")

    r = git(root, "status", "--porcelain")
    gate("working tree is clean", r.stdout.strip() == "",
         f"{len(r.stdout.strip().splitlines())} uncommitted change(s)"
         if r.stdout.strip() else "")

    branch = git(root, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    gate("on a named branch", branch != "HEAD", branch)

    vargs = argparse.Namespace(root=root, json=False, strict=False,
                               max_desc=DEFAULT_MAX_DESC,
                               total_desc=DEFAULT_TOTAL_DESC, limit=3)
    import io, contextlib
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        vrc = cmd_validate(vargs)
    gate("validate", vrc == 0, buf.getvalue().strip().splitlines()[-1] if vrc else "")
    if vrc != 0:
        print("\n" + buf.getvalue())

    if shutil.which("claude"):
        import subprocess
        pv = subprocess.run(["claude", "plugin", "validate", root],
                            capture_output=True, text=True)
        gate("plugin manifests validate", pv.returncode == 0,
             (pv.stdout + pv.stderr).strip().splitlines()[-1] if pv.returncode else "")
    else:
        print("  SKIP  plugin manifests validate — claude is not on PATH")

    version, _, _ = derived_version(root)
    tag = f"{TAG_PREFIX}{version}"
    exists = git(root, "rev-parse", "-q", "--verify", f"refs/tags/{tag}").returncode == 0
    gate(f"tag {tag} is free", not exists, "already exists" if exists else "")

    # The repository's own convention: every release gets a dated changelog entry.
    # Enforced here because a release that skips it is invisible to future readers.
    cl = os.path.join(root, "changelog")
    entry = any(version in open(os.path.join(cl, f), encoding="utf-8",
                                errors="replace").read()
                for f in os.listdir(cl) if f.endswith(".md")) if os.path.isdir(cl) else False
    gate(f"changelog entry for {version}", entry,
         "add one under changelog/ before releasing" if not entry else "")

    last = git(root, "describe", "--tags", "--abbrev=0").stdout.strip() or None
    names = changed_skills(root, last)
    evals = relevant_evals(root, names) if names else {}

    print(f"\nRelease {version}" + (f" (previous tag {last})" if last else ""))
    if names is not None:
        print(f"  {len(names)} skill(s) changed since {last or 'the beginning'}")
    if evals:
        print("  eval cases covering those skills — these are prose, review them by hand:")
        for f, hit in evals.items():
            print(f"    evals/{f}: {', '.join(hit[:6])}"
                  + (f" (+{len(hit) - 6})" if len(hit) > 6 else ""))

    if failures:
        print(f"\nBLOCKED — {len(failures)} gate(s) failed: {', '.join(failures)}")
        return 1

    stale = [m for m, v in manifest_versions(root).items() if v != version]
    print("\nWould do:" if not apply else "\nDoing:")
    print(f"  write {version} to {len(stale)} manifest(s)" if stale
          else "  manifests already at this version")
    if stale:
        print(f"  commit the manifest bump")
    print(f"  tag {tag}")
    print(f"  push {branch} and {tag}" if args.push else "  (push skipped)")
    print("  refresh the local install, then verify it moved")

    if not apply:
        print("\nAll gates passed. Re-run with --apply to release.")
        return 0

    if stale:
        vw = argparse.Namespace(root=root, write=True)
        with contextlib.redirect_stdout(io.StringIO()):
            cmd_version(vw)
        git(root, "add", *MANIFESTS)
        c = git(root, "commit", "-m", f"Release {version}")
        if c.returncode != 0:
            print(f"commit failed: {c.stderr.strip()}")
            return 1

    t = git(root, "tag", "-a", tag, "-m", args.message or f"Release {version}")
    if t.returncode != 0:
        print(f"tag failed: {t.stderr.strip()}")
        return 1

    if args.push:
        p = git(root, "push", "origin", branch, tag)
        if p.returncode != 0:
            print(f"push failed: {p.stderr.strip()}")
            return 1
        print(f"  pushed {branch} and {tag}")

    print()
    args.dry_run = False
    cmd_refresh(args)

    # Prove the install actually moved, rather than trusting refresh's report.
    print("\nPost-release verification")
    skills = repo_skill_names(root)
    config = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude"))
    home = os.path.join(config, "skills")
    if os.path.isdir(home):
        live = {n for n in os.listdir(home)
                if os.path.isfile(os.path.join(home, n, SKILL_FILE))}
        gate("claude install resolves every skill", set(skills) <= live,
             f"missing {sorted(set(skills) - live)[:3]}" if not set(skills) <= live else
             f"{len(skills)} skills")
    mk = os.path.join(root, ".claude-plugin/marketplace.json")
    if shutil.which("codex") and os.path.exists(mk):
        m = json.load(open(mk, encoding="utf-8"))["name"]
        pl = json.load(open(os.path.join(root, ".codex-plugin/plugin.json"),
                            encoding="utf-8"))["name"]
        cache = os.path.expanduser(f"~/.codex/plugins/cache/{m}/{pl}/{version}/skills")
        cached = set(os.listdir(cache)) if os.path.isdir(cache) else set()
        gate("codex cache matches the repo", cached == set(skills),
             f"{len(cached)} cached vs {len(skills)} in repo")

    if failures:
        print(f"\nRELEASED {version}, but {len(failures)} verification(s) failed.")
        return 1
    print(f"\nReleased {version}.")
    return 0


SKILL_TEMPLATE = '''---
name: {name}
description: "{description}"
---

# {title}

<!-- One paragraph: what this skill does and the outcome it produces. -->

## When to use

<!-- Concrete triggers. Mirror the phrasing a user would actually type. -->

## When not to use

<!-- The neighbouring skill that should handle those cases instead. -->

## Workflow

<!-- The steps. Detail belongs here, never in the description. -->
'''


def cmd_new(args):
    root = os.path.abspath(args.root)
    name = args.name.strip()
    if not re.match(r"^[a-z0-9][a-z0-9-]*$", name):
        print(f"invalid name '{name}': use lowercase letters, digits, and hyphens")
        return 1
    target = os.path.join(root, SKILLS_DIR, name)
    if os.path.exists(target):
        print(f"{rel(root, target)} already exists")
        return 1
    desc = (args.description or "").strip()
    if not desc:
        print("a description is required; see policies/skill-format.md for the rule")
        return 1
    if len(desc) > args.max_desc:
        print(f"description is {len(desc)} bytes, limit {args.max_desc} "
              f"(see policies/skill-format.md)")
        return 1
    os.makedirs(target)
    title = name.replace("-", " ").capitalize()
    with open(os.path.join(target, SKILL_FILE), "w", encoding="utf-8") as fh:
        fh.write(SKILL_TEMPLATE.format(
            name=name, description=desc.replace('"', '\\"'), title=title))
    print(f"created {rel(root, os.path.join(target, SKILL_FILE))}")
    print("next: write the body, add the skill to registry.yaml, then run "
          "`bin/skills-sync validate`")
    return 0


def cmd_validate(args):
    root = os.path.abspath(args.root)
    skill_files = find_skill_files(root)
    findings = []

    by_name = check_structure(root, skill_files, findings)
    total = check_budget(root, skill_files, findings, args.max_desc, args.total_desc)
    check_integrity(root, skill_files, by_name, findings)

    if args.strict:
        for f in findings:
            f.severity = ERROR

    errors = [f for f in findings if f.severity == ERROR]
    warns = [f for f in findings if f.severity == WARN]

    if args.json:
        print(json.dumps({
            "skills": len(skill_files),
            "unique_names": len(by_name),
            "description_bytes": total,
            "errors": len(errors),
            "warnings": len(warns),
            "findings": [f.as_dict() for f in findings],
        }, indent=2))
        return 1 if errors else 0

    print(f"skills-sync validate — {len(skill_files)} SKILL.md, "
          f"{len(by_name)} unique names, {total} description bytes\n")

    for group in (errors, warns):
        if not group:
            continue
        by_check = {}
        for f in group:
            by_check.setdefault(f.check, []).append(f)
        for check in sorted(by_check):
            items = by_check[check]
            label = "ERROR" if items[0].severity == ERROR else "warn "
            print(f"{label} {check}  ({len(items)})")
            print(f"      why: {items[0].why}")
            for f in items[:args.limit]:
                print(f"      - {f.path}: {f.message}")
            if len(items) > args.limit:
                print(f"      … and {len(items) - args.limit} more (--limit to show)")
            print()

    if errors:
        print(f"FAILED — {len(errors)} error(s), {len(warns)} warning(s)")
        return 1
    print(f"PASSED — 0 errors, {len(warns)} warning(s)")
    return 0


def main():
    p = argparse.ArgumentParser(prog="skills-sync", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--root", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                   help="repository root (default: the repo containing this script)")
    sub = p.add_subparsers(dest="cmd", required=True)

    v = sub.add_parser("validate", help="check the library against the cross-agent contract")
    v.add_argument("--json", action="store_true", help="machine-readable output")
    v.add_argument("--strict", action="store_true", help="treat warnings as errors")
    v.add_argument("--max-desc", type=int, default=DEFAULT_MAX_DESC,
                   help=f"per-skill description byte limit (default {DEFAULT_MAX_DESC})")
    v.add_argument("--total-desc", type=int, default=DEFAULT_TOTAL_DESC,
                   help=f"library-wide description byte limit (default {DEFAULT_TOTAL_DESC})")
    v.add_argument("--limit", type=int, default=8, help="max items shown per check")
    v.set_defaults(func=cmd_validate)

    m = sub.add_parser("migrate", help="flatten skills/ to the cross-agent layout")
    m.add_argument("--apply", action="store_true",
                   help="perform the migration (default is a dry run)")
    m.add_argument("--limit", type=int, default=8, help="max link rewrites shown per file")
    m.set_defaults(func=cmd_migrate)

    rel_p = sub.add_parser("release", help="gate, publish, and verify a release")
    rel_p.add_argument("--apply", action="store_true",
                       help="perform the release (default is preflight only)")
    rel_p.add_argument("--no-push", dest="push", action="store_false",
                       help="tag locally without pushing")
    rel_p.add_argument("-m", "--message", help="annotation for the tag")
    rel_p.set_defaults(func=cmd_release, push=True)

    ver = sub.add_parser("version", help="derive the plugin version and check the manifests")
    ver.add_argument("--write", action="store_true", help="write the derived version")
    ver.set_defaults(func=cmd_version)

    r = sub.add_parser("refresh", help="reconcile the local install with the repo")
    r.add_argument("--dry-run", action="store_true",
                   help="report what would change without touching anything")
    r.add_argument("--quiet", action="store_true",
                   help="print only when something changed")
    r.set_defaults(func=cmd_refresh)

    u = sub.add_parser("upstream", help="compare vendored skills against their sources")
    u.add_argument("--source", help="limit to one source id from registry.yaml")
    u.add_argument("--offline", action="store_true", help="use the cached clone only")
    u.add_argument("--show-adaptations", action="store_true",
                   help="list the files that differ from the pinned commit")
    u.add_argument("--pin", metavar="SOURCE",
                   help="after adopting changes, record the new upstream commit")
    u.set_defaults(func=cmd_upstream)

    d = sub.add_parser("doctor", help="report drift without changing anything")
    d.add_argument("--json", action="store_true", help="machine-readable output")
    d.add_argument("--strict", action="store_true", help="fail on warnings too")
    d.set_defaults(func=cmd_doctor)

    b = sub.add_parser("bootstrap", help="set up this machine from a fresh clone")
    b.add_argument("--role", choices=("author", "consumer"),
                   help="author edits skills here; consumer only uses them")
    b.add_argument("--apply", action="store_true",
                   help="perform the setup (default is a dry run)")
    b.set_defaults(func=cmd_bootstrap)

    h = sub.add_parser("hooks", help="report or install the committed git hooks")
    h.add_argument("--install", action="store_true", help="set core.hooksPath")
    h.add_argument("--uninstall", action="store_true", help="unset core.hooksPath")
    h.set_defaults(func=cmd_hooks)

    n = sub.add_parser("new", help="scaffold a conformant skill")
    n.add_argument("name", help="skill name (lowercase, hyphens)")
    n.add_argument("-d", "--description", required=True,
                   help="trigger contract; see policies/skill-format.md")
    n.add_argument("--max-desc", type=int, default=DEFAULT_MAX_DESC)
    n.set_defaults(func=cmd_new)

    args = p.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
